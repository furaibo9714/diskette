<?xml version="1.0" encoding="utf-8"?>
<merge
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  tools:parentTag="android.widget.FrameLayout"
  >

  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/compactMovieRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    >

    <ImageView
      android:id="@+id/compactMovieImage"
      android:layout_width="@dimen/compactImageWidth"
      android:layout_height="@dimen/compactImageHeight"
      android:background="@drawable/bg_media_view_elevation"
      android:elevation="@dimen/elevationSmall"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      />

    <ImageView
      android:id="@+id/compactMoviePlaceholder"
      android:layout_width="@dimen/compactImageWidth"
      android:layout_height="@dimen/compactImageHeight"
      android:background="@drawable/bg_media_view_placeholder"
      android:elevation="@dimen/elevationSmall"
      android:padding="@dimen/spaceMedium"
      android:visibility="gone"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:srcCompat="@drawable/ic_film"
      app:tint="?attr/colorPlaceholderIcon"
      tools:visibility="visible"
      />

    <ProgressBar
      android:id="@+id/compactMovieProgress"
      style="@style/ProgressBar.Dark"
      android:layout_width="20dp"
      android:layout_height="20dp"
      android:visibility="gone"
      app:layout_constraintBottom_toBottomOf="@id/compactMovieImage"
      app:layout_constraintEnd_toEndOf="@id/compactMovieImage"
      app:layout_constraintStart_toStartOf="@id/compactMovieImage"
      app:layout_constraintTop_toTopOf="@id/compactMovieImage"
      tools:visibility="visible"
      />

    <TextView
      android:id="@+id/compactMovieTitle"
      style="@style/CollectionItem.Title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spaceMedium"
      android:layout_marginEnd="@dimen/spaceMedium"
      android:ellipsize="end"
      android:maxLines="1"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toEndOf="@id/compactMovieImage"
      app:layout_constraintTop_toTopOf="parent"
      tools:text="The Godfather"
      />

  </androidx.constraintlayout.widget.ConstraintLayout>

</merge>
